<UserControl x:Class="WorldClocks.Views.TrayPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorldClocks.ViewModels"
             xmlns:conv="clr-namespace:WorldClocks.Converters"
             MinWidth="270" MaxWidth="380"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibility" />
    </UserControl.Resources>

    <Border Background="#FF242424" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="0,6">
            <TextBlock Text="World Clocks" FontSize="12" FontWeight="SemiBold"
                       Foreground="#FF9AA0A6" Margin="14,4,14,6" />

            <ItemsControl ItemsSource="{Binding Clocks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ClockViewModel}">
                        <Grid Margin="14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#FF9AA0A6" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource StringNullOrEmptyToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border Background="#FF4A3B14" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Visibility="{Binding DateBadge, Converter={StaticResource StringNullOrEmptyToVisibility}}">
                                    <TextBlock Text="{Binding DateBadge}" Foreground="#FFE8B84B" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding TimeDisplay}" Foreground="White" FontSize="16"
                                           FontFamily="Consolas" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No clocks yet — right-click the tray icon and choose Settings to add one."
                       Foreground="#FF9AA0A6" FontSize="11" TextWrapping="Wrap"
                       Margin="14,4,14,8" Visibility="{Binding EmptyStateVisibility}" />

            <Separator Margin="0,4,0,4" Background="#FF3A3A3A" />

            <TextBlock Text="Right-click the tray icon for Settings" Foreground="#FF6E7377" FontSize="10"
                       Margin="14,2,14,4" />
        </StackPanel>
    </Border>
</UserControl>
