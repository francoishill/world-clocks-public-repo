<Window x:Class="WorldClocks.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WorldClocks.ViewModels"
        Title="World Clocks Settings" Height="520" Width="560" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Timezone" FontWeight="SemiBold" Margin="4,0" />
            <TextBlock Grid.Column="1" Text="Title (e.g. Los Angeles)" FontWeight="SemiBold" Margin="4,0" />
            <TextBlock Grid.Column="2" Text="Subtitle (e.g. colleagues)" FontWeight="SemiBold" Margin="4,0" />
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ClockEntryEditViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="4,3"
                                  ItemsSource="{Binding TimeZones}"
                                  SelectedItem="{Binding SelectedTimeZone}"
                                  DisplayMemberPath="DisplayName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  IsSynchronizedWithCurrentItem="False"
                                  StaysOpenOnEdit="True"
                                  Text="{Binding TimeZoneSearchText, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"
                                  LostFocus="TimeZoneComboBox_LostFocus" />
                        <TextBox Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2" Margin="4,3" VerticalContentAlignment="Center"
                                 Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
            <Button Content="Add clock" Command="{Binding AddClockCommand}" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="Remove" Command="{Binding RemoveClockCommand}" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="Move Up" Command="{Binding MoveUpCommand}" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="Move Down" Command="{Binding MoveDownCommand}" Padding="10,5" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <CheckBox Content="Start automatically when Windows starts" IsChecked="{Binding AutoStartEnabled}"
                      Margin="0,0,24,0" VerticalAlignment="Center" />
            <CheckBox Content="Use 24-hour time" IsChecked="{Binding Use24HourTime}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Save &amp; Close" Padding="16,6" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
