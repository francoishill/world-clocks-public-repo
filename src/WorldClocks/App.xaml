<Application x:Class="WorldClocks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WorldClocks"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:views="clr-namespace:WorldClocks.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Lives entirely outside the visual tree; DataContext and Icon are set explicitly
                 in App.xaml.cs, since the icon is drawn procedurally at startup (see IconRenderer). -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="World Clocks"
                            PopupActivation="LeftClick"
                            MenuActivation="RightClick">
                <tb:TaskbarIcon.TrayPopup>
                    <views:TrayPopupView />
                </tb:TaskbarIcon.TrayPopup>
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
                        <Separator />
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
